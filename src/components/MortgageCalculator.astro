---
/**
 * Spitzer (annuity) mortgage calculator. Illustration only.
 * Each value has a range slider plus a number field so it works with keyboard and typing.
 */
interface Props {
  id?: string;
  heading?: string;
  headingLevel?: 'h2' | 'h3';
}

const { id = 'calc', heading = 'מחשבון משכנתא מהיר', headingLevel: H = 'h2' } = Astro.props;

const fields = [
  { key: 'amount', label: 'סכום המשכנתא (₪)', min: 100000, max: 5000000, step: 10000, value: 1000000 },
  { key: 'years', label: 'תקופה (שנים)', min: 4, max: 30, step: 1, value: 25 },
  { key: 'rate', label: 'ריבית שנתית (%)', min: 0.5, max: 10, step: 0.05, value: 4.5 },
];
---

<form class="sheet p-5 sm:p-6" data-calculator aria-labelledby={`${id}-title`} onsubmit="return false">
  <H id={`${id}-title`} class="mb-1 text-lg font-bold">{heading}</H>
  <p class="mb-2 text-sm text-ink-soft">החזר חודשי משוער בשיטת שפיצר.</p>

  {fields.map((f) => (
    <div class="mt-4">
      <div class="flex items-center justify-between gap-3">
        <label for={`${id}-${f.key}`} class="font-medium">{f.label}</label>
        <input
          id={`${id}-${f.key}`}
          type="number"
          inputmode="decimal"
          min={f.min}
          max={f.max}
          step={f.step}
          value={f.value}
          data-num={f.key}
          dir="ltr"
          class="w-32 rounded-lg border-2 border-ink/20 bg-paper px-2 py-1.5 text-end font-bold tabular-nums focus:border-line"
        />
      </div>
      <input
        type="range"
        min={f.min}
        max={f.max}
        step={f.step}
        value={f.value}
        data-range={f.key}
        aria-label={f.label}
        dir="rtl"
        class="range mt-2"
      />
    </div>
  ))}

  <div class="mt-6 flex items-baseline justify-between gap-3 rounded-xl bg-ink p-4 text-white">
    <span>החזר חודשי משוער</span>
    <output data-result aria-live="polite" class="text-3xl font-extrabold tabular-nums" dir="ltr">-</output>
  </div>
  <p class="mt-3 text-xs text-muted">
    חישוב להמחשה בלבד, בריבית קבועה ולא צמודה. אינו כולל הצמדה, עמלות או ביטוחים, ואינו מהווה הצעה או ייעוץ.
  </p>
</form>

<script>
  const fmt = new Intl.NumberFormat('he-IL', { style: 'currency', currency: 'ILS', maximumFractionDigits: 0 });

  document.querySelectorAll<HTMLFormElement>('[data-calculator]').forEach((form) => {
    const get = (key: string) => form.querySelector<HTMLInputElement>(`[data-num="${key}"]`)!;
    const range = (key: string) => form.querySelector<HTMLInputElement>(`[data-range="${key}"]`)!;
    const out = form.querySelector<HTMLOutputElement>('[data-result]')!;

    const paint = (rng: HTMLInputElement) => {
      const min = Number(rng.min);
      const max = Number(rng.max);
      const pct = ((Number(rng.value) - min) / (max - min)) * 100;
      rng.style.setProperty('--p', String(Math.min(100, Math.max(0, pct))));
    };

    const compute = () => {
      const P = Number(get('amount').value);
      const n = Number(get('years').value) * 12;
      const r = Number(get('rate').value) / 100 / 12;
      if (!(P > 0 && n > 0 && r >= 0)) {
        out.textContent = '-';
        return;
      }
      const payment = r === 0 ? P / n : (P * r) / (1 - Math.pow(1 + r, -n));
      out.textContent = fmt.format(payment);
    };

    for (const key of ['amount', 'years', 'rate']) {
      const num = get(key);
      const rng = range(key);
      rng.addEventListener('input', () => {
        num.value = rng.value;
        paint(rng);
        compute();
      });
      num.addEventListener('input', () => {
        rng.value = num.value;
        paint(rng);
        compute();
      });
      paint(rng);
    }
    compute();
  });
</script>
