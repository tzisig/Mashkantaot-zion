---
import { site } from '../config/site';

interface Props {
  /** Use the white version on dark surfaces. */
  onDark?: boolean;
  class?: string;
}

const { onDark = false, class: className } = Astro.props;
const src = onDark ? '/brand/logo-horizontal-onDark.svg' : '/brand/logo-horizontal.svg';
---

<a href="/" class={`inline-flex items-center no-underline ${className ?? ''}`} aria-label={`${site.name} - דף הבית`}>
  <img src={src} alt={site.name} width="220" height="46" class="h-10 w-auto md:h-11" />
</a>
