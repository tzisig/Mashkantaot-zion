---
import { site } from '../config/site';

interface Props {
  /** Use the white version on dark surfaces. */
  onDark?: boolean;
  /** Stacked lockup instead of the horizontal one. */
  stacked?: boolean;
  /** Drop the tagline - it is unreadable below roughly 56px of lockup height. */
  noTagline?: boolean;
  class?: string;
}

const { onDark = false, stacked = false, noTagline = false, class: className } = Astro.props;
const src = `/brand/logo-${stacked ? 'stacked' : 'horizontal'}${noTagline ? '-notag' : ''}${onDark ? '-onDark' : ''}.svg`;
const size = stacked
  ? { width: 210, height: noTagline ? 190 : 250, cls: 'h-32 w-auto' }
  : { width: 220, height: noTagline ? 34 : 46, cls: noTagline ? 'h-9 w-auto md:h-10' : 'h-12 w-auto md:h-14' };
---

<a href="/" class={`inline-flex items-center no-underline ${className ?? ''}`} aria-label={`${site.name} - דף הבית`}>
  <img src={src} alt={site.name} width={size.width} height={size.height} class={size.cls} />
</a>
