---
interface Props {
  items: { q: string; a: string }[];
  heading?: string;
  id?: string;
}

const { items, heading = 'שאלות נפוצות', id = 'faq' } = Astro.props;
---

{items.length > 0 && (
  <section aria-labelledby={`${id}-title`} class="mt-14">
    <h2 id={`${id}-title`} class="text-2xl font-bold">{heading}</h2>
    <div class="mt-5 divide-y divide-ink/12 border-y border-ink/12">
      {items.map((item) => (
        <details class="group py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-bold marker:hidden">
            {item.q}
            <span aria-hidden="true" class="text-line transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="mt-3 text-ink-soft">{item.a}</p>
        </details>
      ))}
    </div>
  </section>
)}
