---
/**
 * Inline Lucide icon (SVG, currentColor). Decorative by default;
 * pass `label` when the icon carries meaning on its own.
 */
interface Props {
  name: string;
  size?: number;
  class?: string;
  label?: string;
}

const { name, size = 22, class: className, label } = Astro.props;

const icons = import.meta.glob<string>('/node_modules/lucide-static/icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const raw = icons[`/node_modules/lucide-static/icons/${name}.svg`];
if (!raw) throw new Error(`Unknown icon: ${name}`);

const a11y = label ? `role="img" aria-label="${label}"` : 'aria-hidden="true" focusable="false"';
const svg = raw
  .replace(/<!--.*?-->/s, '')
  .replace('<svg', `<svg ${a11y} class="${className ?? ''}" stroke-width="1.75"`)
  .replace(/\s(width|height)="24"/g, ` $1="${size}"`)
  .replace(/\sclass="lucide[^"]*"/, '')
  .replace(/\sstroke-width="2"/, '');
---

<Fragment set:html={svg} />
