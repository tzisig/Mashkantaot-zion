---
import ContactButtons from './ContactButtons.astro';
import Icon from './Icon.astro';
import { site } from '../config/site';

interface Props {
  title?: string;
  text?: string;
}

const {
  title = 'רוצים לבדוק את המקרה שלכם?',
  text = 'שיחת היכרות קצרה, בלי התחייבות. נעבור על הנתונים ונראה אם ואיך אפשר לעזור.',
} = Astro.props;
---

<aside class="sheet p-6">
  <p class="mono-tag" aria-hidden="true">// NEXT STEP</p>
  <h2 class="mt-2 text-xl font-bold">{title}</h2>
  <p class="mt-2 text-ink-soft">{text}</p>
  <div class="mt-5 [&_.btn]:w-full">
    <ContactButtons layout="stack" />
  </div>
  {site.bookingUrl && (
    <a href="/book" class="btn btn-outline mt-3 w-full" data-track="book_meeting_click">
      <Icon name="calendar" size={20} /> לקביעת פגישה ביומן
    </a>
  )}
  <a href="/contact" class="btn btn-outline mt-3 w-full">לטופס יצירת קשר</a>
</aside>
