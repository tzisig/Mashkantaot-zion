---
import Icon from './Icon.astro';
import { phoneLink, whatsappLink } from '../config/site';

// Sticky bar on small screens. WhatsApp is the primary action, phone secondary.
// Renders only the actions that are configured in src/config/site.ts.
const tel = phoneLink();
const wa = whatsappLink('היי, הגעתי מהאתר ואשמח לבדוק אפשרות למשכנתא');
---

{(tel || wa) && (
  <div class="fixed inset-x-0 bottom-0 z-40 grid border-t-2 border-ink bg-surface md:hidden" style={`grid-template-columns: ${tel && wa ? '1.4fr 1fr' : '1fr'}`}>
    {wa && (
      <a href={wa} class="flex min-h-14 items-center justify-center gap-2 bg-coral font-bold text-white no-underline" data-track="whatsapp_click" rel="noopener" target="_blank">
        <Icon name="message-circle" /> וואטסאפ
      </a>
    )}
    {tel && (
      <a href={tel} class="flex min-h-14 items-center justify-center gap-2 font-bold text-ink no-underline" data-track="phone_click">
        <Icon name="phone" /> להתקשר
      </a>
    )}
  </div>
)}
