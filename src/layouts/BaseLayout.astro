---
import '../styles/global.css';
import rubikHebrew from '@fontsource-variable/rubik/files/rubik-hebrew-wght-normal.woff2?url';
import Seo, { type SeoProps } from '../components/Seo.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import MobileActionBar from '../components/MobileActionBar.astro';

interface Props extends SeoProps {
  /** Draft copy awaiting owner approval. Shows a badge in dev only. */
  draft?: boolean;
}

const { draft = false, ...seo } = Astro.props;
const showDraft = draft && import.meta.env.DEV;
---

<!doctype html>
<html lang="he" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0b1f3a" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" href={rubikHebrew} as="font" type="font/woff2" crossorigin />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} />
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a href="#main" class="sr-only z-50 rounded-[10px] bg-ink px-4 py-3 text-white focus:not-sr-only focus:fixed focus:start-4 focus:top-4">
      דילוג לתוכן הראשי
    </a>
    {showDraft && (
      <div class="bg-draft px-4 py-1.5 text-center text-sm text-ink">טיוטה - הטקסטים בעמוד ממתינים לאישור</div>
    )}
    <Header />
    <main id="main" tabindex="-1" class="pb-14 md:pb-0">
      <slot />
    </main>
    <Footer />
    <MobileActionBar />

    <script>
      // One-time reveal on scroll. CSS keeps content visible when JS or motion is off.
      const els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -10% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
