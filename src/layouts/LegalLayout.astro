---
import BaseLayout from './BaseLayout.astro';
import type { SeoProps } from '../components/Seo.astro';

interface Props extends SeoProps {
  heading: string;
  updated: string;
}

const { heading, updated, ...seo } = Astro.props;
---

<BaseLayout {...seo} draft>
  <header class="border-b-2 border-ink bg-surface">
    <div class="container-site py-10 md:py-14">
      <p class="mono-tag" aria-hidden="true">// LEGAL</p>
      <h1 class="mt-3 text-[clamp(1.9rem,4vw,2.75rem)] font-extrabold">{heading}</h1>
      <p class="mt-3 text-sm text-muted">עודכן: {updated}</p>
      <p class="mt-5 max-w-3xl rounded-[10px] border-2 border-ink bg-draft p-4 text-ink">
        <strong>טיוטה לבדיקת עורך דין.</strong> הנוסח הזה נכתב כבסיס עבודה בלבד, הוא אינו ייעוץ משפטי, ואין להסתמך
        עליו לפני שעורך דין אישר אותו והתאים אותו לפעילות בפועל.
      </p>
    </div>
  </header>

  <div class="container-site py-10 md:py-14">
    <div class="prose-mz"><slot /></div>
  </div>
</BaseLayout>
