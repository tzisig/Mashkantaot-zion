---
import BaseLayout from '../layouts/BaseLayout.astro';
import CtaCard from '../components/CtaCard.astro';
import Missing from '../components/Missing.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import { site } from '../config/site';
import { pricing, formatPrice } from '../config/pricing';

const notIncluded = [
  'עמלות ותשלומים שגובים הבנק או הגוף המממן',
  'שמאות, ביטוח משכנתא, אגרות ורישום בטחונות',
  'שכר טרחת עורך דין בעסקת הנכס',
];

const faqs = [
  {
    q: 'המחיר באתר הוא המחיר הסופי?',
    a: 'המספרים כאן הם נקודת הפתיחה, ובתיקים רבים הם גם המחיר בפועל. את המחיר המדויק אתם מקבלים בכתב אחרי שיחת ההיכרות, כשכבר ידוע מה התיק דורש, ורק אז מחליטים.',
  },
  {
    q: 'שיחת ההיכרות עולה כסף?',
    a: 'לא. היא נועדה לבדוק אם אנחנו בכלל יכולים לעזור לכם. אם התשובה היא לא, נגיד את זה ולא ייגבה תשלום.',
  },
  {
    q: 'למה פגישת האפיון בתשלום אם שיחת ההיכרות חינם?',
    a: 'כי הן שני דברים שונים. שיחת ההיכרות היא בדיקה אם יש מה לעשות. פגישת האפיון היא כבר העבודה עצמה: מיפוי הנתונים ובניית מבנה מוצע. אם אתם ממשיכים לליווי מלא, התשלום על האפיון מתקזז במלואו.',
  },
  {
    q: 'מתי משלמים?',
    a: 'אחרי שיחת ההיכרות אתם מקבלים הצעת מחיר ברורה עם מה שכלול ומה לא, ורק אם אתם מאשרים אותה מתחילים לעבוד.',
  },
  {
    q: 'יש תשלום אם לא קיבלתי אישור?',
    a: 'זה נקבע מראש ונכתב בהצעת המחיר, כדי שלא יהיו הפתעות בשום כיוון.',
  },
];

const offers = pricing.tiers
  .filter((t) => t.from !== null)
  .map((t) => ({
    '@type': 'Offer',
    name: t.name,
    priceCurrency: 'ILS',
    priceSpecification: {
      '@type': 'PriceSpecification',
      priceCurrency: 'ILS',
      [t.exact ? 'price' : 'minPrice']: t.from,
    },
  }));
---

<BaseLayout
  title="מחירון ייעוץ משכנתאות, המחירים באתר"
  description="כמה עולה ייעוץ משכנתאות אצלנו: שיחת היכרות ללא עלות, פגישת אפיון שמתקזזת, וליווי מלא במחיר שידוע לכם מראש. מה כלול בעבודה ומה לא."
  draft
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'Service',
      name: 'ייעוץ משכנתאות',
      serviceType: 'ייעוץ משכנתאות',
      provider: { '@type': 'FinancialService', name: site.name, url: site.url },
      areaServed: { '@type': 'Country', name: 'ישראל' },
      offers,
    },
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <header class="blueprint border-b-2 border-ink">
    <div class="container-site py-12 md:py-16">
      <p class="mono-tag" aria-hidden="true">// PRICING</p>
      <h1 class="mt-3 text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">מחיר <span class="marker">בלי הפתעות</span></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        המחירים כתובים כאן, לפני שאתם מתקשרים. אתם יודעים כמה זה עולה ומה בדיוק אתם מקבלים בתמורה.
      </p>
    </div>
  </header>

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
    <div>
      <div class="prose-mz">
        <p>
          רוב האתרים בתחום מסבירים כמה עולה יועץ משכנתאות בלי לומר כמה הם עצמם גובים. אנחנו חושבים שזו לא הדרך
          להתחיל היכרות, ולכן המספרים כאן.
        </p>
        <p>
          <strong>שכר הטרחה שלנו מגיע מכם בלבד.</strong> אנחנו לא מקבלים עמלה מהבנק ולא מגוף מימון אחר, וזה מה
          שמאפשר להמליץ על מה שנכון לכם גם כשזה לא נוח לאף אחד אחר.
        </p>
      </div>

      <section aria-labelledby="tiers-title" class="mt-10">
        <h2 id="tiers-title" class="sr-only">מסלולי השירות והמחירים</h2>
        <ul class="grid gap-5 sm:grid-cols-2">
          {pricing.tiers.map((tier) => (
            <li
              class={`flex h-full flex-col rounded-[16px] bg-surface p-6 ${
                tier.featured ? 'border-2 border-ink shadow-sheet' : 'border border-ink/12'
              }`}
            >
              <h3 class="text-xl font-bold">{tier.name}</h3>
              <p class="mt-3 text-3xl font-extrabold text-ink [font-variant-numeric:tabular-nums]">
                {formatPrice(tier) ?? <Missing what={`מחיר ל${tier.name}`} />}
              </p>
              {tier.note && <p class="mt-1 text-sm text-muted">{tier.note}</p>}
              <p class="mt-4 text-ink-soft">{tier.who}</p>
              <ul class="mt-4 space-y-2 border-t border-ink/10 pt-4">
                {tier.includes.map((item) => (
                  <li class="flex gap-2.5">
                    <span class="mt-0.5 shrink-0 text-success"><Icon name="circle-check" size={19} /></span>
                    <span class="text-[0.95rem] text-ink-soft">{item}</span>
                  </li>
                ))}
              </ul>
            </li>
          ))}
        </ul>
        <p class="mt-5 text-sm text-muted">
          {pricing.vatNote ?? <Missing what="ניסוח מע״מ (כולל / לא כולל / עוסק פטור)" />}
        </p>
      </section>

      <section aria-labelledby="not-included-title" class="mt-12">
        <h2 id="not-included-title" class="text-2xl font-bold">מה לא כלול</h2>
        <p class="mt-2 text-ink-soft">אלה תשלומים לגורמים אחרים, ולא אלינו:</p>
        <ul class="mt-4 space-y-3">
          {notIncluded.map((item) => (
            <li class="flex gap-3">
              <span class="mt-0.5 text-muted"><Icon name="circle-alert" size={22} /></span>
              <span class="text-ink-soft">{item}</span>
            </li>
          ))}
        </ul>
      </section>

      <Faq items={faqs} />
    </div>

    <div class="lg:sticky lg:top-24 lg:self-start">
      <CtaCard
        title="לא בטוחים איזה מסלול מתאים?"
        text="שיחת היכרות קצרה ואחריה הצעת מחיר בכתב. בלי התחייבות."
      />
    </div>
  </div>
</BaseLayout>
