---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaCard from '../../components/CtaCard.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const services = await getCollection('services');
  return services.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'services'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const data = entry.data;

const all = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
// Guides that were written to support this service page.
const guides = (await getCollection('guides'))
  .filter((g) => g.data.supports === `/services/${entry.id}`)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const others = all.filter((s) => s.id !== entry.id).slice(0, 3);

const faqSchema =
  data.faqs.length > 0
    ? [
        {
          '@context': 'https://schema.org',
          '@type': 'FAQPage',
          mainEntity: data.faqs.map((f) => ({
            '@type': 'Question',
            name: f.q,
            acceptedAnswer: { '@type': 'Answer', text: f.a },
          })),
        },
      ]
    : [];

const breadcrumbs = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'דף הבית', item: `${site.url}/` },
    { '@type': 'ListItem', position: 2, name: 'שירותים', item: `${site.url}/services` },
    { '@type': 'ListItem', position: 3, name: data.heading, item: `${site.url}/services/${entry.id}` },
  ],
};

const updated = data.updated.toLocaleDateString('he-IL', { year: 'numeric', month: 'long' });

/** Resolves "config:a.b" values against the site config, so figures live in one place. */
const resolveFact = (value: string) => {
  if (!value.startsWith('config:')) return value;
  const path = value.slice('config:'.length).split('.');
  let current: unknown = site;
  for (const key of path) current = (current as Record<string, unknown>)?.[key];
  return String(current ?? '');
};
---

<BaseLayout
  title={data.title}
  description={data.description}
  draft={data.draft}
  schema={[breadcrumbs, ...faqSchema]}
>
  <nav aria-label="פירורי לחם" class="border-b border-ink/10 bg-surface">
    <ol class="container-site flex gap-2 py-3 text-sm text-ink-soft">
      <li><a href="/">דף הבית</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/services">שירותים</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page">{data.heading}</li>
    </ol>
  </nav>

  <article>
    <header class="blueprint border-b-2 border-ink">
      <div class="container-site py-12 md:py-16">
        <p class="mono-tag" aria-hidden="true">// {String(data.order).padStart(2, '0')} SERVICE</p>
        <h1 class="mt-3 max-w-3xl text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">{data.heading}</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-soft">{data.summary}</p>
      </div>
    </header>

    <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
      <div>
        <div class="prose-mz"><Content /></div>

        {data.facts.length > 0 && (
          <dl class="mt-10 grid gap-4 sm:grid-cols-2">
            {data.facts.map((f) => (
              <div class="sheet p-5">
                <dt class="text-sm text-ink-soft">{f.label}</dt>
                <dd class="mt-1 text-3xl font-extrabold tabular-nums">{resolveFact(f.value)}</dd>
              </div>
            ))}
          </dl>
        )}

        <Faq items={data.faqs} />

        {data.sources.length > 0 && (
          <section aria-labelledby="sources-title" class="mt-14 rounded-[16px] bg-surface p-6">
            <h2 id="sources-title" class="sr-only">מקורות</h2>
            <p class="mono-tag" aria-hidden="true">// SOURCES</p>
            <ul class="mt-3 space-y-2 text-sm text-ink-soft">
              {data.sources.map((s) => (
                <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-muted">עודכן: {updated}. המידע כללי ואינו מהווה ייעוץ או הצעה.</p>
          </section>
        )}
      </div>

      <div class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <CtaCard />
        {guides.length > 0 && (
          <nav aria-labelledby="guides-title" class="rounded-[16px] border border-ink/12 bg-surface p-6">
            <h2 id="guides-title" class="sr-only">מדריכים קשורים</h2>
            <p class="mono-tag" aria-hidden="true">// GUIDES</p>
            <ul class="mt-3 space-y-3">
              {guides.map((g) => (
                <li>
                  <a href={`/guides/${g.id}`} class="flex items-start justify-between gap-2 font-bold text-ink no-underline hover:text-line-strong">
                    {g.data.heading ?? g.data.title}
                    <span class="mt-1 shrink-0 text-line"><Icon name="arrow-left" size={18} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
        <nav aria-labelledby="related-title" class="rounded-[16px] border border-ink/12 bg-surface p-6">
          <h2 id="related-title" class="sr-only">שירותים נוספים</h2>
          <p class="mono-tag" aria-hidden="true">// MORE</p>
          <ul class="mt-3 space-y-3">
            {others.map((s) => (
              <li>
                <a href={`/services/${s.id}`} class="flex items-center justify-between gap-2 font-bold text-ink no-underline hover:text-line-strong">
                  {s.data.heading}
                  <span class="text-line"><Icon name="arrow-left" size={18} /></span>
                </a>
              </li>
            ))}
            <li>
              <a href="/mortgage-calculator" class="flex items-center justify-between gap-2 font-bold text-ink no-underline hover:text-line-strong">
                מחשבון משכנתא
                <span class="text-line"><Icon name="arrow-left" size={18} /></span>
              </a>
            </li>
          </ul>
        </nav>
      </div>
    </div>
  </article>
</BaseLayout>
