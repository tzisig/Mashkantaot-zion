---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Icon from '../../components/Icon.astro';
import CtaCard from '../../components/CtaCard.astro';

const services = (await getCollection('services')).sort((a, b) => a.data.order - b.data.order);
const pad = (n: number) => String(n).padStart(2, '0');
---

<BaseLayout
  title="שירותי ייעוץ משכנתאות"
  description="מחזור משכנתא, איחוד הלוואות, משכנתא לרכישת דירה, מסורבי בנקים, הלוואות חוץ בנקאיות, משכנתא לכל מטרה ומשכנתא הפוכה. הסבר על כל שירות ומה בודקים בו."
  draft
>
  <header class="blueprint border-b-2 border-ink">
    <div class="container-site py-12 md:py-16">
      <p class="mono-tag">// SERVICES</p>
      <h1 class="mt-3 text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">מה אפשר <span class="marker">לבדוק יחד</span></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        לכל מצב יש בדיקה משלו. בכל עמוד כתוב מה בודקים, מה המגבלות שקובעות את התשובה, ומה חשוב לוודא לפני שחותמים.
      </p>
    </div>
  </header>

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
    <ul class="grid gap-5 sm:grid-cols-2">
      {services.map((s) => (
        <li>
          <a href={`/services/${s.id}`} class="group flex h-full flex-col gap-3 rounded-[16px] border border-ink/12 bg-surface p-6 text-ink no-underline transition-shadow hover:shadow-sheet">
            <span class="mono-tag">{pad(s.data.order)}</span>
            <span class="grid size-12 place-items-center rounded-[10px] bg-paper text-line-strong"><Icon name={s.data.icon} size={26} /></span>
            <span class="text-xl font-bold">{s.data.heading}</span>
            <span class="text-[0.95rem] text-ink-soft">{s.data.summary}</span>
            <span class="mt-auto flex items-center gap-2 pt-2 font-bold text-line-strong">
              לפרטים <span class="transition-transform group-hover:-translate-x-1"><Icon name="arrow-left" size={18} /></span>
            </span>
          </a>
        </li>
      ))}
    </ul>

    <div class="lg:sticky lg:top-24 lg:self-start">
      <CtaCard />
    </div>
  </div>
</BaseLayout>
