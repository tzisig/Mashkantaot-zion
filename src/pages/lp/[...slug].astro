---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import LandingLayout from '../../layouts/LandingLayout.astro';
import LeadForm from '../../components/LeadForm.astro';
import MortgageCalculator from '../../components/MortgageCalculator.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';

export async function getStaticPaths() {
  const pages = await getCollection('landing');
  return pages.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'landing'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// Highlight the marker phrase inside the headline without hand-written markup.
const [before, after] = d.marker ? d.headline.split(d.marker) : [d.headline, ''];
---

<LandingLayout
  variant={d.variant}
  draft={d.draft}
  title={d.title}
  description={d.description}
>
  <section class="blueprint border-b-2 border-ink">
    <div class="container-site grid gap-10 py-10 md:py-16 lg:grid-cols-[1.05fr_0.95fr]">
      <div>
        <p class="mono-tag" aria-hidden="true">{d.eyebrow}</p>
        <h1 class="mt-3 text-[clamp(2rem,5vw,3.4rem)] font-extrabold">
          {before}{d.marker && <span class="marker">{d.marker}</span>}{after}
        </h1>
        <p class="mt-5 max-w-[36rem] text-lg text-ink-soft md:text-xl">{d.subhead}</p>

        {d.bullets.length > 0 && (
          <ul class="mt-7 space-y-3">
            {d.bullets.map((b) => (
              <li class="flex gap-3">
                <span class="mt-0.5 text-success"><Icon name="circle-check" size={22} /></span>
                <span class="text-ink-soft">{b}</span>
              </li>
            ))}
          </ul>
        )}

        <a href="#lead" class="btn btn-primary mt-8" data-track="cta_hero">{d.ctaLabel}</a>
      </div>

      <div class="space-y-5">
        {d.showCalculator && <MortgageCalculator id="lp" heading="בדקו את ההחזר שלכם" />}
        <div id="lead" class="scroll-mt-6">
          <div class="mb-3">
            <h2 class="text-xl font-bold">{d.formHeading}</h2>
            <p class="text-ink-soft">{d.formNote}</p>
          </div>
          <LeadForm variant={d.variant} compact={d.compactForm} submitLabel={d.ctaLabel} />
        </div>
      </div>
    </div>
  </section>

  {d.steps.length > 0 && (
    <section aria-labelledby="steps-title" class="border-b-2 border-ink bg-surface py-14">
      <div class="container-site">
        <p class="mono-tag" aria-hidden="true">// PROCESS</p>
        <h2 id="steps-title" class="mt-2 text-[clamp(1.6rem,3.4vw,2.25rem)] font-bold">איך זה עובד</h2>
        <ol class="mt-8 grid gap-5 md:grid-cols-4">
          {d.steps.map((s, i) => (
            <li class="sheet p-5">
              <span class="mono-tag" aria-hidden="true">STEP {String(i + 1).padStart(2, '0')}</span>
              <h3 class="mt-2 text-lg font-bold">{s.title}</h3>
              <p class="mt-2 text-ink-soft">{s.text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>
  )}

  <section class="py-14">
    <div class="container-site grid gap-12 lg:grid-cols-[minmax(0,1fr)_320px]">
      <div>
        <div class="prose-mz"><Content /></div>
        <Faq items={d.faqs} />
      </div>

      <aside class="lg:sticky lg:top-8 lg:self-start">
        <div class="sheet p-6">
          <p class="mono-tag" aria-hidden="true">// NEXT STEP</p>
          <h2 class="mt-2 text-xl font-bold">{d.formHeading}</h2>
          <p class="mt-2 text-ink-soft">{d.formNote}</p>
          <a href="#lead" class="btn btn-primary mt-5 w-full" data-track="cta_sidebar">{d.ctaLabel}</a>
        </div>
      </aside>
    </div>
  </section>
</LandingLayout>
