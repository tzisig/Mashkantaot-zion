---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaCard from '../../components/CtaCard.astro';
import Faq from '../../components/Faq.astro';
import Icon from '../../components/Icon.astro';
import { site } from '../../config/site';

export async function getStaticPaths() {
  const posts = await getCollection('guides');
  return posts.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'guides'>;
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

const services = await getCollection('services');
const supported = d.supports ? services.find((s) => `/services/${s.id}` === d.supports) : undefined;

const others = (await getCollection('guides'))
  .filter((p) => p.id !== entry.id)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf())
  .slice(0, 3);

const url = `${site.url}/guides/${entry.id}`;
const fmt = (date: Date) => date.toLocaleDateString('he-IL', { year: 'numeric', month: 'long', day: 'numeric' });
// Hebrew reads at roughly 200 words a minute; the count comes from the raw markdown.
const words = (entry.body ?? '').split(/\s+/).filter(Boolean).length;
const minutes = Math.max(2, Math.round(words / 200));

const schema: Record<string, unknown>[] = [
  {
    '@context': 'https://schema.org',
    '@type': 'Article',
    headline: d.title,
    description: d.description,
    inLanguage: 'he',
    datePublished: d.published.toISOString(),
    dateModified: (d.updated ?? d.published).toISOString(),
    author: { '@type': 'Organization', name: site.name, url: site.url },
    publisher: { '@type': 'Organization', name: site.name, url: site.url },
    mainEntityOfPage: url,
  },
  {
    '@context': 'https://schema.org',
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'דף הבית', item: `${site.url}/` },
      { '@type': 'ListItem', position: 2, name: 'מדריכים', item: `${site.url}/guides` },
      { '@type': 'ListItem', position: 3, name: d.title, item: url },
    ],
  },
];

if (d.faqs.length > 0) {
  schema.push({
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: d.faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  });
}
---

<BaseLayout title={d.title} description={d.description} draft={d.draft} schema={schema}>
  <nav aria-label="פירורי לחם" class="border-b border-ink/10 bg-surface">
    <ol class="container-site flex gap-2 py-3 text-sm text-ink-soft">
      <li><a href="/">דף הבית</a></li>
      <li aria-hidden="true">/</li>
      <li><a href="/guides">מדריכים</a></li>
      <li aria-hidden="true">/</li>
      <li aria-current="page" class="truncate">{d.heading ?? d.title}</li>
    </ol>
  </nav>

  <article>
    <header class="blueprint border-b-2 border-ink">
      <div class="container-site py-12 md:py-16">
        <p class="mono-tag">// GUIDE</p>
        <h1 class="mt-3 max-w-3xl text-[clamp(1.9rem,4.4vw,3rem)] font-extrabold">{d.heading ?? d.title}</h1>
        <p class="mt-4 max-w-2xl text-lg text-ink-soft">{d.description}</p>
        <p class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-1 text-sm text-muted">
          <span>פורסם: {fmt(d.published)}</span>
          {d.updated && <span>עודכן: {fmt(d.updated)}</span>}
          <span>{minutes} דקות קריאה</span>
        </p>
      </div>
    </header>

    <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
      <div>
        <div class="prose-mz"><Content /></div>

        <Faq items={d.faqs} />

        {d.sources.length > 0 && (
          <section aria-labelledby="sources-title" class="mt-14 rounded-[16px] bg-surface p-6">
            <h2 id="sources-title" class="mono-tag">// SOURCES</h2>
            <ul class="mt-3 space-y-2 text-sm text-ink-soft">
              {d.sources.map((s) => (
                <li><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label}</a></li>
              ))}
            </ul>
            <p class="mt-4 text-xs text-muted">המידע כללי ואינו מהווה ייעוץ או הצעה. הוראות ורגולציה משתנות מעת לעת.</p>
          </section>
        )}

        {others.length > 0 && (
          <nav aria-labelledby="more-title" class="mt-14">
            <h2 id="more-title" class="text-2xl font-bold">מדריכים נוספים</h2>
            <ul class="mt-4 grid gap-3 sm:grid-cols-2">
              {others.map((post) => (
                <li>
                  <a href={`/guides/${post.id}`} class="flex items-center justify-between gap-2 rounded-[10px] border border-ink/12 bg-surface p-4 font-bold text-ink no-underline hover:border-line">
                    {post.data.heading ?? post.data.title}
                    <span class="text-line"><Icon name="arrow-left" size={18} /></span>
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )}
      </div>

      <div class="space-y-6 lg:sticky lg:top-24 lg:self-start">
        <CtaCard />
        {supported && (
          <nav class="rounded-[16px] border border-ink/12 bg-surface p-6">
            <h2 class="mono-tag">// RELATED SERVICE</h2>
            <a href={d.supports} class="mt-3 flex items-center justify-between gap-2 font-bold text-ink no-underline hover:text-line-strong">
              {supported.data.heading}
              <span class="text-line"><Icon name="arrow-left" size={18} /></span>
            </a>
            <p class="mt-2 text-sm text-ink-soft">{supported.data.summary}</p>
          </nav>
        )}
      </div>
    </div>
  </article>
</BaseLayout>
