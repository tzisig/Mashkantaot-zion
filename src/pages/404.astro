---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="העמוד לא נמצא" description="העמוד שחיפשת לא נמצא." noindex>
  <section class="blueprint flex-1 border-b-2 border-ink">
    <div class="container-site py-24">
      <p class="mono-tag" aria-hidden="true">// ERROR 404</p>
      <h1 class="mt-3 text-[clamp(2rem,5vw,3.25rem)] font-extrabold">העמוד <span class="marker">לא נמצא</span></h1>
      <p class="mt-4 text-lg text-ink-soft">יכול להיות שהכתובת השתנתה, או שהעמוד עדיין בבנייה.</p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href="/" class="btn btn-primary">לדף הבית</a>
        <a href="/services" class="btn btn-outline">לשירותים</a>
      </div>
    </div>
  </section>
</BaseLayout>
