---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactButtons from '../components/ContactButtons.astro';
import LeadForm from '../components/LeadForm.astro';
import Missing from '../components/Missing.astro';
import Icon from '../components/Icon.astro';
import { site, phoneLink, whatsappLink } from '../config/site';

const wa = whatsappLink('היי, הגעתי מהאתר ואשמח לבדוק אפשרות למשכנתא');
const tel = phoneLink();

---

<BaseLayout
  title="צרו קשר"
  description="שיחת היכרות קצרה בלי התחייבות: בוואטסאפ, בטלפון או בטופס. משאירים פרטים ואנחנו חוזרים אליכם בערוץ שנוח לכם."
  draft
>
  <header class="blueprint border-b-2 border-ink">
    <div class="container-site py-12 md:py-16">
      <p class="mono-tag">// CONTACT</p>
      <h1 class="mt-3 text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">בואו <span class="marker">נדבר</span></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        הדרך המהירה ביותר היא וואטסאפ. אפשר גם טלפון או טופס, ונחזור אליכם בערוץ שתבחרו.
      </p>
      <div class="mt-6"><ContactButtons showPlaceholders /></div>
    </div>
  </header>

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
    <div>
      <h2 class="text-2xl font-bold">השארת פרטים</h2>
      <p class="mt-2 text-ink-soft">
        הפרטים שתמלאו משמשים אותנו כדי לחזור אליכם בלבד. אין צורך לצרף מסמכים בשלב הזה, ואי אפשר להעלות אותם כאן.
      </p>

      <div class="mt-6"><LeadForm /></div>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
      <div class="sheet p-6">
        <p class="mono-tag">// DIRECT</p>
        <ul class="mt-4 space-y-2">
          <li>
            {wa ? (
              <a
                href={wa}
                target="_blank"
                rel="noopener"
                data-track="whatsapp_click"
                class="group flex items-center gap-3 rounded-[10px] border-2 border-ink/10 p-3 text-ink no-underline transition-colors hover:border-line hover:bg-paper"
              >
                <span class="grid size-10 shrink-0 place-items-center rounded-[10px] bg-coral text-white"><Icon name="message-circle" size={20} /></span>
                <span>
                  <span class="block font-bold">שליחת הודעה בוואטסאפ</span>
                  <span class="block text-sm text-ink-soft">הדרך המהירה ביותר לקבל מאיתנו תשובה</span>
                </span>
              </a>
            ) : (
              <p class="flex items-center gap-2 p-3 text-ink-soft"><Icon name="message-circle" size={20} /> וואטסאפ: <Missing what="מספר וואטסאפ" /></p>
            )}
          </li>
          <li>
            {tel ? (
              <a
                href={tel}
                data-track="phone_click"
                class="flex items-center gap-3 rounded-[10px] border-2 border-ink/10 p-3 text-ink no-underline transition-colors hover:border-line hover:bg-paper"
              >
                <span class="grid size-10 shrink-0 place-items-center rounded-[10px] bg-ink text-white"><Icon name="phone" size={20} /></span>
                <span>
                  <span class="block font-bold">דברו איתנו בטלפון</span>
                  <span class="block text-sm text-ink-soft">שיחה קצרה, בלי התחייבות ובלי תשלום</span>
                </span>
              </a>
            ) : (
              <p class="flex items-center gap-2 p-3 text-ink-soft"><Icon name="phone" size={20} /> טלפון: <Missing what="טלפון" /></p>
            )}
          </li>
          <li>
            {site.contact.email ? (
              <a
                href={`mailto:${site.contact.email}`}
                data-track="email_click"
                class="flex items-center gap-3 rounded-[10px] border-2 border-ink/10 p-3 text-ink no-underline transition-colors hover:border-line hover:bg-paper"
              >
                <span class="grid size-10 shrink-0 place-items-center rounded-[10px] bg-ink text-white"><Icon name="mail" size={20} /></span>
                <span class="min-w-0">
                  <span class="block font-bold">שליחת מייל</span>
                  <span class="block text-sm text-ink-soft">מתאים אם נוח לכם לכתוב את הפרטים בפירוט</span>
                </span>
              </a>
            ) : (
              <p class="flex items-center gap-2 p-3 text-ink-soft"><Icon name="mail" size={20} /> מייל: <Missing what="מייל" /></p>
            )}
          </li>
        </ul>

        <p class="mt-4 flex items-start gap-2 text-sm text-ink-soft">
          <span class="mt-0.5 text-muted"><Icon name="clock" size={18} /></span>
          שעות מענה: {site.businessHours ?? <Missing what="שעות פעילות" />}
        </p>
        <p class="mt-2 text-sm text-muted">שירות בכל הארץ. פגישות פרונטליות, בזום או בטלפון.</p>
      </div>

      <div class="rounded-[16px] border border-ink/12 bg-surface p-6">
        <p class="mono-tag">// DOCUMENTS</p>
        <p class="mt-2 text-ink-soft">
          מסמכים לא נשלחים דרך האתר. <a href="/documents">כאן מוסבר</a> איך מעבירים אותם בצורה מאובטחת, אחרי שיחת ההיכרות.
        </p>
      </div>
    </aside>
  </div>
</BaseLayout>
