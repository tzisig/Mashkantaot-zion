---
import BaseLayout from '../layouts/BaseLayout.astro';
import Faq from '../components/Faq.astro';
import CtaCard from '../components/CtaCard.astro';

const groups = [
  {
    title: 'על הייעוץ עצמו',
    items: [
      {
        q: 'למה בכלל צריך יועץ, הבנק לא עושה את זה בחינם?',
        a: 'בבנק יושב מולכם נציג של הבנק, שמציע את המוצרים של הבנק שלו. זה לגיטימי, אבל זה לא השוואה. אנחנו עובדים בשבילכם, משווים בין גופים ובונים מבנה לפי הנתונים שלכם.',
      },
      {
        q: 'אנחנו מקבלים עמלה מהבנקים?',
        a: 'לא. השכר שלנו מגיע מהלקוח ולא מהבנק, ולכן אנחנו עובדים בשביל הלקוח. זה מה שמאפשר להמליץ על הגוף שמתאים לכם, ולא על מי שמשלם לנו. את השאלה הזו כדאי לשאול כל יועץ, ובפירוש.',
      },
      {
        q: 'אפשר לעשות את זה לבד?',
        a: 'בהחלט אפשר, ויש אנשים שעושים את זה טוב. השאלה היא כמה זמן זה ייקח לכם, כמה אתם מכירים את ההבדלים בין המסלולים, ומה עולה טעות. זה אתם צריכים להחליט.',
      },
      {
        q: 'כמה זה עולה?',
        a: 'המחיר נקבע לפי העבודה שנדרשת בפועל, ואתם מקבלים אותו בכתב אחרי שיחת היכרות. פירוט מלא נמצא בעמוד המחירים.',
      },
    ],
  },
  {
    title: 'על התהליך',
    items: [
      {
        q: 'כמה זמן לוקח תהליך משכנתא?',
        a: 'זה תלוי בסוג העסקה, בגופים שמעורבים ובקצב שבו מגיעים המסמכים. אחרי שאנחנו רואים את התיק אפשר לתת לוח זמנים ריאלי, ולא לפני כן.',
      },
      {
        q: 'אילו מסמכים תצטרך ממני?',
        a: 'בדרך כלל תלושי שכר או דוחות לעצמאים, תדפיסי חשבון, פירוט הלוואות קיימות, ומסמכי הנכס אם יש עסקה. את הרשימה המדויקת אתם מקבלים אחרי שיחת ההיכרות.',
      },
      {
        q: 'איך מעבירים מסמכים?',
        a: 'לא דרך האתר. אחרי שיחת ההיכרות אנחנו שולחים לכם קישור לתיקייה ייעודית, ומשם ההעברה מוצפנת ומסודרת. ההסבר המלא נמצא בעמוד העברת מסמכים.',
      },
      {
        q: 'אתם מגיעים לפגישות?',
        a: 'אנחנו עובדים עם לקוחות בכל הארץ. פגישה יכולה להיות פרונטלית, בזום או בטלפון, לפי מה שנוח לכם.',
      },
    ],
  },
  {
    title: 'שאלות מקצועיות נפוצות',
    items: [
      {
        q: 'כמה הון עצמי צריך?',
        a: 'לרכישת דירה יחידה, המימון מוגבל ל-75% משווי הנכס לפי הוראות בנק ישראל, ולכן ההון העצמי המינימלי הוא 25% ועוד עלויות הרכישה. לדירה חליפית 70% ולדירה להשקעה 50%.',
      },
      {
        q: 'מה מגביל את סכום המשכנתא שאקבל?',
        a: 'שני דברים: שיעור המימון מול שווי הנכס, ושיעור ההחזר מההכנסה, שלפי ההוראה לא יעלה על 50% ובפועל נעצר אצל רוב הבנקים סביב 40%.',
      },
      {
        q: 'כדאי למחזר עכשיו?',
        a: 'אי אפשר לענות על זה בלי לראות את התמהיל הקיים ואת עלות היציאה מכל מסלול. יש מקרים שבהם מחזור חוסך, ויש מקרים שבהם העמלות אוכלות את כל היתרון.',
      },
      {
        q: 'יש לי סירוב מהבנק. זה נגמר?',
        a: 'לא בהכרח. קודם מבררים למה בדיוק סירבו, כי אם הסיבה היא נתון שלכם, היא תלווה אתכם גם לגוף הבא. יש עמוד שלם שמוקדש לזה.',
      },
    ],
  },
];

const all = groups.flatMap((g) => g.items);
---

<BaseLayout
  title="שאלות נפוצות על ייעוץ משכנתאות"
  description="התשובות לשאלות שחוזרות הכי הרבה: האם צריך יועץ, כמה זה עולה, איזה מסמכים נדרשים, כמה הון עצמי צריך ומה עושים אחרי סירוב מהבנק."
  draft
  schema={[
    {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: all.map((f) => ({
        '@type': 'Question',
        name: f.q,
        acceptedAnswer: { '@type': 'Answer', text: f.a },
      })),
    },
  ]}
>
  <header class="blueprint border-b-2 border-ink">
    <div class="container-site py-12 md:py-16">
      <p class="mono-tag" aria-hidden="true">// FAQ</p>
      <h1 class="mt-3 text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">שאלות <span class="marker">נפוצות</span></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        אלה השאלות שאנחנו נשאלים הכי הרבה. אם שלכם לא נמצאת כאן, שלחו אותה ונענה.
      </p>
    </div>
  </header>

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
    <div>
      {groups.map((g, i) => (
        <section class={i > 0 ? 'mt-12' : ''}>
          <p class="mono-tag" aria-hidden="true">// {String(i + 1).padStart(2, '0')}</p>
          <Faq items={g.items} heading={g.title} id={`faq-${i}`} />
        </section>
      ))}
    </div>

    <div class="lg:sticky lg:top-24 lg:self-start">
      <CtaCard title="לא מצאתם תשובה?" text="שלחו לנו את השאלה בוואטסאפ ונחזור אליכם." />
    </div>
  </div>
</BaseLayout>
