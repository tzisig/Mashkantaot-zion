---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import CtaCard from '../../components/CtaCard.astro';
import Icon from '../../components/Icon.astro';

const areas = (await getCollection('areas')).sort((a, b) => a.data.city.localeCompare(b.data.city, 'he'));
---

<BaseLayout
  title="אזורי שירות - ייעוץ משכנתאות בכל הארץ"
  description="ייעוץ משכנתאות ללקוחות בכל הארץ, בפגישה פרונטלית, בזום או בטלפון. לערים שמהן מגיעות הכי הרבה פניות יש עמוד ייעודי."
  draft
>
  <header class="blueprint border-b-2 border-ink">
    <div class="container-site py-12 md:py-16">
      <p class="mono-tag">// AREAS</p>
      <h1 class="mt-3 text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">עובד עם לקוחות <span class="marker">בכל הארץ</span></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        רוב התהליך מתנהל ממילא בשיחות ובמסמכים, ולכן המרחק כמעט לא משנה. כשנוח לכם להיפגש פנים אל פנים, מתאמים פגישה.
      </p>
    </div>
  </header>

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
    <div>
      <h2 class="text-2xl font-bold">ערים עם עמוד ייעודי</h2>
      <ul class="mt-5 grid gap-4 sm:grid-cols-2">
        {areas.map((a) => (
          <li>
            <a href={`/areas/${a.id}`} class="group flex h-full flex-col gap-2 rounded-[16px] border border-ink/12 bg-surface p-5 text-ink no-underline transition-shadow hover:shadow-sheet">
              <span class="flex items-center justify-between gap-2 text-xl font-bold">
                {a.data.city}
                <span class="text-line transition-transform group-hover:-translate-x-1"><Icon name="arrow-left" size={18} /></span>
              </span>
              <span class="text-[0.95rem] text-ink-soft">{a.data.summary}</span>
            </a>
          </li>
        ))}
      </ul>

      <div class="prose-mz mt-12">
        <h2>לא רואים את העיר שלכם?</h2>
        <p>
          זה לא אומר שאני לא עובד שם. העמודים כאן נבנו לערים שמהן מגיעות הכי הרבה פניות, ויתווספו עוד בהמשך.
          בפועל אני עובד עם לקוחות בכל הארץ, והבדיקה זהה: המגבלות של בנק ישראל אינן משתנות לפי עיר.
        </p>
        <p>
          מה שכן משתנה הוא שווי הנכס, השמאות ולעיתים סוג הרישום. אלה משפיעים על שיעור המימון בפועל, וזה נבדק
          פרטנית בכל תיק.
        </p>
      </div>
    </div>

    <div class="lg:sticky lg:top-24 lg:self-start">
      <CtaCard />
    </div>
  </div>
</BaseLayout>
