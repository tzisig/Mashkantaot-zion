---
import BaseLayout from '../layouts/BaseLayout.astro';
import MortgageCalculator from '../components/MortgageCalculator.astro';
import Faq from '../components/Faq.astro';
import CtaCard from '../components/CtaCard.astro';
import { site } from '../config/site';

const faqs = [
  {
    q: 'המחשבון מדויק?',
    a: 'הוא מחשב נכון את ההחזר בשיטת שפיצר עבור ריבית קבועה אחת, אבל משכנתא אמיתית מורכבת מכמה מסלולים, חלקם צמודים למדד וחלקם בריבית משתנה. לכן המספר כאן הוא הערכה, לא הצעה.',
  },
  {
    q: 'למה ההחזר שהבנק נתן לי שונה?',
    a: 'כי הבנק מחשב לפי התמהיל שהציע לכם, כולל הצמדה, עמלות וביטוחים, ולפי הריביות שאושרו לכם בפועל. המחשבון לא מכיר את הנתונים האלה.',
  },
  {
    q: 'מה זה לוח שפיצר?',
    a: 'שיטת החזר שבה התשלום החודשי קבוע, וההרכב שלו משתנה: בהתחלה רוב התשלום הוא ריבית ובהמשך רוב התשלום הוא קרן. זו השיטה הנפוצה בישראל.',
  },
  {
    q: 'כמה משכנתא אפשר בכלל לקבל?',
    a: 'שתי מגבלות של בנק ישראל קובעות: שיעור המימון מול שווי הנכס, ושיעור ההחזר מההכנסה. הסבר מלא נמצא בעמוד המשכנתא לרכישת דירה.',
  },
];

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: faqs.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: 'מחשבון משכנתא',
    applicationCategory: 'FinanceApplication',
    operatingSystem: 'Web',
    url: `${site.url}/mortgage-calculator`,
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'ILS' },
  },
];
---

<BaseLayout
  title="מחשבון משכנתא - החזר חודשי, סך תשלומים וריבית"
  description="מחשבון משכנתא פשוט: מזינים סכום, תקופה וריבית ומקבלים החזר חודשי משוער, סך התשלומים וכמה מתוכם ריבית. חישוב שפיצר, להמחשה בלבד."
  draft
  schema={schema}
>
  <header class="blueprint border-b-2 border-ink">
    <div class="container-site py-12 md:py-16">
      <p class="mono-tag">// CALCULATOR</p>
      <h1 class="mt-3 text-[clamp(2rem,4.6vw,3.25rem)] font-extrabold">מחשבון <span class="marker">משכנתא</span></h1>
      <p class="mt-4 max-w-2xl text-lg text-ink-soft">
        שלושה נתונים, ומיד רואים את ההחזר החודשי, את סך התשלומים ואת חלק הריבית מתוכם.
      </p>
    </div>
  </header>

  <div class="container-site grid gap-12 py-12 lg:grid-cols-[minmax(0,1fr)_320px] lg:py-16">
    <div>
      <MortgageCalculator id="full" heading="נתוני ההלוואה" headingLevel="h2" showTotals />

      <div class="prose-mz mt-12">
        <h2>איך לקרוא את התוצאה</h2>
        <p>
          ההחזר החודשי הוא המספר שכולם מסתכלים עליו, אבל הוא לבדו לא אומר אם העסקה טובה. שימו לב דווקא לשתי השורות
          שמתחתיו: סך התשלומים וחלק הריבית. שם מתגלה מה עלתה ההלוואה באמת.
        </p>
        <p>
          תעשו ניסוי קטן: קחו את אותו סכום, והאריכו את התקופה בחמש שנים. ההחזר החודשי יירד, וזה נעים. סך הריבית יעלה,
          וזה פחות נעים. אין כאן תשובה נכונה אחת, יש כאן החלטה: כמה אתם מוכנים לשלם בסך הכל תמורת נשימה חודשית.
        </p>

        <h2>מה המחשבון הזה לא יודע</h2>
        <p>
          הוא מחשב מסלול אחד בריבית קבועה. משכנתא אמיתית מורכבת מכמה מסלולים במקביל, וכל אחד מהם מתנהג אחרת: יש צמודי
          מדד שהיתרה שלהם משתנה לפי האינפלציה, יש ריבית משתנה שמתעדכנת בתחנות, ויש מסלולים שיקר לצאת מהם באמצע.
        </p>
        <p>
          לכן שתי הצעות עם אותו החזר חודשי בדיוק יכולות להיות שונות מאוד בעלות הכוללת ובסיכון. זו בדיוק העבודה של
          בניית תמהיל, ואת זה שום מחשבון לא עושה בשבילכם.
        </p>

        <h2>מה כדאי לבדוק אחרי שחישבתם</h2>
        <p>
          אם המספר שיצא לכם מרגיש גבוה, עוד לפני שמוותרים על דירה מסוימת שווה לבדוק את שתי המגבלות שקובעות כמה בכלל
          אפשר לקבל: שיעור המימון מול שווי הנכס ושיעור ההחזר מההכנסה. שתיהן מוסברות בעמוד
          <a href="/services/new-mortgage">משכנתא לרכישת דירה</a>.
        </p>
        <p>
          ואם יש לכם כבר משכנתא, המספר שמעניין הוא אחר לגמרי: מה ההחזר שלכם היום לעומת מה שאפשר לקבל, וכמה עולה
          לצאת מהמסלולים הקיימים. על זה כתבתי ב<a href="/services/mortgage-refinance">מחזור משכנתא</a>.
        </p>
      </div>

      <Faq items={faqs} />
    </div>

    <div class="lg:sticky lg:top-24 lg:self-start">
      <CtaCard
        title="רוצים לראות את המספרים האמיתיים?"
        text="שלחו לי את הנתונים ואחזור אליכם עם תמונה מלאה, כולל העלות הכוללת ולא רק ההחזר החודשי."
      />
    </div>
  </div>
</BaseLayout>
